{
  "entities": {
    "Product": {
      "title": "StyleX Product",
      "description": "Premium luxury product listings.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "slug": { "type": "string" },
        "price": { "type": "number" },
        "old_price": { "type": "number" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "sizes": { "type": "array" },
        "stock": { "type": "number" },
        "featured": { "type": "boolean" },
        "image_url": { "type": "string" },
        "additional_images": { "type": "array" },
        "free_delivery": { "type": "boolean" },
        "majestic_highlight": { "type": "boolean" },
        "trending": { "type": "boolean" }
      },
      "required": ["id", "name", "price"]
    },
    "SiteSettings": {
      "title": "StyleX Site Settings",
      "description": "Global settings for UI customization, lottery configurations, and brand content.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "site_name": { "type": "string" },
        "whatsapp_number": { "type": "string" },
        "delivery_charge": { "type": "number" },
        "seo_title": { "type": "string" },
        "seo_description": { "type": "string" },
        "seo_keywords": { "type": "string" },
        "seo_og_image": { "type": "string" },
        "apps_script_url": { "type": "string" },
        "logo_text_s": { "type": "string" },
        "logo_text_x": { "type": "string" },
        "logo_text_title": { "type": "string" },
        "logo_text_subtitle": { "type": "string" },
        "banners": { "type": "array" },
        "lottery_coin_reward": { "type": "number" },
        "campaign_coin_reward": { "type": "number" },
        "gift_discount_percent": { "type": "number" },
        "gift_discount_type": { "type": "string" },
        "gift_discount_value": { "type": "number" },
        "lottery_prizes": { "type": "array" },
        "lottery_enabled": { "type": "boolean" },
        "popup_enabled": { "type": "boolean" },
        "popup_title": { "type": "string" },
        "popup_message": { "type": "string" },
        "popup_coupon_code": { "type": "string" },
        "popup_image_url": { "type": "string" }
      },
      "required": ["id", "site_name"]
    },
    "Review": {
      "title": "Product Review",
      "description": "Customer feedback and ratings for purchased product catalogs.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "product_id": { "type": "string" },
        "user_id": { "type": "string" },
        "customer_name": { "type": "string" },
        "rating": { "type": "number" },
        "comment": { "type": "string" },
        "approved": { "type": "boolean" },
        "created_at": { "type": "string" }
      },
      "required": ["id", "product_id", "customer_name", "rating"]
    },
    "ChatMessage": {
      "title": "Chat Message",
      "description": "Active real-time communication between guests and VIP administration concierge.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "sender_id": { "type": "string" },
        "receiver_id": { "type": "string" },
        "message": { "type": "string" },
        "seen": { "type": "boolean" },
        "created_at": { "type": "string" }
      },
      "required": ["id", "sender_id", "receiver_id", "message"]
    },
    "Coupon": {
      "title": "Promo Coupon",
      "description": "Discounts and luxury access vouchers.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "discount_type": { "type": "string" },
        "discount_value": { "type": "number" },
        "min_order_amount": { "type": "number" },
        "active": { "type": "boolean" }
      },
      "required": ["id", "code", "discount_type", "discount_value"]
    },
    "Order": {
      "title": "Customer Purchase Order",
      "description": "Gilded VIP purchase checkout ledgers with order line items.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "order_number": { "type": "string" },
        "user_id": { "type": "string" },
        "status": { "type": "string" },
        "subtotal": { "type": "number" },
        "delivery_charge": { "type": "number" },
        "total": { "type": "number" },
        "customer_name": { "type": "string" },
        "customer_phone": { "type": "string" },
        "customer_address": { "type": "string" },
        "payment_method": { "type": "string" },
        "created_at": { "type": "string" },
        "order_items": { "type": "array" }
      },
      "required": ["id", "order_number", "customer_name", "customer_phone", "total"]
    },
    "AppUser": {
      "title": "Application User Profile",
      "description": "Client metadata profiles.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "full_name": { "type": "string" },
        "phone": { "type": "string" },
        "role": { "type": "string" },
        "avatar_url": { "type": "string" }
      },
      "required": ["id", "email"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Collection of luxurious designer clothing & timepieces."
    },
    "/site_settings/{settingsId}": {
      "schema": "SiteSettings",
      "description": "System configs and banners."
    },
    "/reviews/{reviewId}": {
      "schema": "Review",
      "description": "Customer reviews."
    },
    "/chats/{chatId}": {
      "schema": "ChatMessage",
      "description": "VIP Concierge real-time messaging histories."
    },
    "/coupons/{couponId}": {
      "schema": "Coupon",
      "description": "Dynamic discounts and voucher configurations."
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Purchase transaction ledgers."
    },
    "/users/{userId}": {
      "schema": "AppUser",
      "description": "User profile records."
    }
  }
}
